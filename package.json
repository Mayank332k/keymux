{
  "name": "keymux",
  "version": "1.0.0",
  "description": "Enterprise-grade API Key Multiplexer & Translation Proxy for LLMs — TTFT routing, zero-downtime failover, and resilient model translation",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./proxy": {
      "types": "./dist/proxy/index.d.ts",
      "import": "./dist/proxy/index.js",
      "require": "./dist/proxy/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "keymux": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test && npm run typecheck"
  },
  "keywords": [
    "llm",
    "api-key",
    "load-balancer",
    "rate-limiter",
    "nvidia",
    "openai",
    "langchain",
    "failover",
    "circuit-breaker",
    "proxy",
    "translation",
    "anthropic",
    "claude"
  ],
  "author": "",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "openai": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    }
  },
  "dependencies": {
    "@types/figlet": "^1.7.0",
    "cfonts": "^3.3.1",
    "chalk": "^5.6.2",
    "figlet": "^1.11.4"
  }
}
